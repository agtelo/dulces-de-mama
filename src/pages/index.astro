---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Invite from '../components/Invite.astro';
import Jar from '../components/Jar.astro';
import Season from '../components/Season.astro';
import Path from '../components/Path.astro';
import Voices from '../components/Voices.astro';
import Door from '../components/Door.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import BackTop from '../components/BackTop.astro';
---

<BaseLayout
  title="Dulces de Mamá | Mermeladas caseras en Buenos Aires"
  description="Mermeladas y dulces caseros de mamá en Buenos Aires. Lotes chicos, fruta de temporada. Pedí por WhatsApp a amigos y conocidos."
>
  <Header />
  <main id="contenido">
    <Invite />
    <Jar />
    <Season />
    <Path />
    <Voices />
    <Door />
  </main>
  <Footer />
  <StickyCta />
  <BackTop />
</BaseLayout>
