---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** URL canónica del sitio cuando esté en producción */
  canonical?: string;
}

const {
  title = 'Dulces de Mamá | Mermeladas caseras en Buenos Aires',
  description =
    'Mermeladas y dulces caseros de mamá en Buenos Aires. Lotes chicos, fruta de temporada. Pedí por WhatsApp a amigos y conocidos.',
  canonical = 'https://dulces-de-mama.vercel.app/',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const ogImage = new URL(`${base}img/foto-producto.jpg`.replace(/\/\//g, '/'), canonical).href;
const favicon = `${base}img/icono-frasco.jpg`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FoodEstablishment',
  name: 'Dulces de Mamá',
  description,
  url: canonical,
  image: ogImage,
  telephone: '+5491131547166',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Buenos Aires',
    addressRegion: 'CABA',
    addressCountry: 'AR',
  },
  areaServed: {
    '@type': 'City',
    name: 'Buenos Aires',
  },
  servesCuisine: 'Mermeladas y dulces caseros',
  priceRange: '$$',
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
    opens: '09:00',
    closes: '20:00',
  },
  sameAs: [],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    telephone: '+5491131547166',
    availableLanguage: 'Spanish',
  },
};
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="mermelada casera, dulces caseros, mermelada Buenos Aires, Dulces de Mamá, mermelada artesanal, frutilla, membrillo, pedido WhatsApp"
    />
    <meta name="author" content="Dulces de Mamá" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:locale" content="es_AR" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dulces de Mamá" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Frasco de mermelada casera Dulces de Mamá" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#A61B34" />
    <link rel="icon" href={favicon} type="image/jpeg" />
    <link rel="apple-touch-icon" href={favicon} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Amatic+SC:wght@400;700&family=Cabin:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="has-sticky-cta">
    <a class="skip-link" href="#inicio">Ir al contenido</a>
    <slot />
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: var(--space-4);
    top: -100px;
    z-index: 100;
    padding: 0.75rem 1.25rem;
    background: var(--berry);
    color: var(--white);
    font-weight: 700;
    font-size: 0.95rem;
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-md);
    transition: top 0.15s ease;
  }
  .skip-link:focus {
    top: var(--space-4);
    outline: 4px solid var(--peach);
    outline-offset: 3px;
  }

  a:focus-visible,
  button:focus-visible {
    outline: 4px solid var(--peach);
    outline-offset: 3px;
  }
  .nav-links a:focus-visible,
  .nav-panel a:focus-visible {
    outline-offset: 2px;
  }

  .sticky-cta {
    padding-bottom: calc(1.15rem + env(safe-area-inset-bottom, 0px));
  }
  body.has-sticky-cta {
    padding-bottom: calc(6.5rem + env(safe-area-inset-bottom, 0px));
  }
  @media (min-width: 768px) {
    body.has-sticky-cta {
      padding-bottom: 0;
    }
  }

  .path-head p,
  .path-step p,
  .path-extra {
    color: #4a3a30;
  }
  .path-extra strong {
    color: var(--ink);
  }

  @media (max-width: 380px) {
    .invite h1 {
      font-size: 2.4rem;
    }
  }
</style>
