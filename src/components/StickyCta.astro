---
const wa =
  'https://wa.me/5491131547166?text=' +
  encodeURIComponent('Hola! Quiero pedir Dulces de Mamá');
---
<div class="sticky-cta" role="region" aria-label="Pedir por WhatsApp">
  <a class="btn btn-primary" href={wa} target="_blank" rel="noopener" data-cart-wa id="sticky-wa">Escribime</a>
  <p class="sticky-hint">Se abre WhatsApp</p>
</div>

<style>
  .sticky-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }
  .sticky-hint {
    font-size: 0.75rem;
    color: var(--muted);
  }
  @media (min-width: 768px) {
    .sticky-cta {
      display: none;
    }
  }
</style>

<script is:inline>
  window.addEventListener('ddm-cart', function (e) {
    var a = document.getElementById('sticky-wa');
    var hint = document.querySelector('.sticky-hint');
    if (!a || !e.detail) return;
    a.setAttribute('href', e.detail.href);
    var n = (e.detail.items || []).length;
    a.textContent = n ? 'Enviar pedido' : 'Escribime';
    if (hint) hint.textContent = n ? 'WhatsApp con tu pedido' : 'Se abre WhatsApp';
  });
</script>
