---
const wa = 'https://wa.me/54911XXXXXXXX?text=Hola!%20Quiero%20pedir%20Dulces%20de%20Mamá';
---
<div class="fixed bottom-0 left-0 right-0 z-50 border-t border-line bg-paper px-4 py-3 shadow-[0_-4px_16px_rgba(44,33,24,0.08)] md:hidden">
  <a
    href={wa}
    target="_blank"
    rel="noopener"
    class="mx-auto flex min-h-[52px] w-full max-w-md items-center justify-center gap-1.5 rounded-full bg-berry px-8 py-3 font-semibold text-white-soft transition hover:bg-berry-hover"
  >
    Pedir por WhatsApp <span aria-hidden="true">→</span>
  </a>
</div>
