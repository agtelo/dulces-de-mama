---
const wa = 'https://wa.me/54911XXXXXXXX?text=Hola!%20Quiero%20consultar%20por%20Dulces%20de%20Mamá';
---

<section class="door" id="puerta">
  <div class="container">
    <div class="door-panel">
      <p class="door-kicker">La puerta</p>
      <h2>Si te late, escribime.</h2>
      <p>
        Consultas, encargues, regalos o solo preguntar qué hay esta semana.
        Respondemos con calma.
      </p>
      <a class="btn btn-on-dark btn-lg" href={wa} target="_blank" rel="noopener">Abrir WhatsApp</a>
      <p class="door-meta">Buenos Aires · CABA y alrededores · Solo círculo cercano</p>
    </div>
  </div>
</section>
