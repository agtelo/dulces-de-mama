---
const base = import.meta.env.BASE_URL;
const wa =
  'https://wa.me/5491131547166?text=' +
  encodeURIComponent('Hola! Vi Dulces de Mamá y quiero pedir');
const heroBg = `${base}img/hero-frutos.jpg`;
---

<section
  class="invite"
  id="inicio"
  style={`background-image: url('${heroBg}')`}
>
  <div class="invite-veil" aria-hidden="true"></div>
  <div class="container invite-inner">
    <p class="invite-kicker">De la cocina de mamá</p>
    <h1>Hola. Acá se hace mermelada con tiempo.</h1>
    <p class="invite-lead">
      No es fábrica ni local. Es la cocina de casa, abierta para amigos y
      conocidos. Lotes chicos, fruta de temporada, y el mismo cariño de siempre.
      Ideal para el mate, el desayuno del domingo o un regalo de verdad.
    </p>
    <div class="invite-actions">
      <a class="btn btn-primary" href={wa} target="_blank" rel="noopener">Quiero pedir</a>
      <a class="btn btn-ghost" href="#temporada">Ver qué hay</a>
    </div>
  </div>
</section>

<style>
  .invite {
    position: relative;
    padding: var(--space-16) 0 var(--space-20);
    text-align: center;
    background-color: var(--cream);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    overflow: hidden;
  }
  .invite-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(246, 240, 230, 0.45) 0%,
      rgba(246, 240, 230, 0.28) 40%,
      rgba(246, 240, 230, 0.55) 100%
    );
    pointer-events: none;
  }
  .invite-inner {
    position: relative;
    z-index: 1;
    max-width: var(--container);
    margin-inline: auto;
  }
  .invite-inner .invite-lead {
    text-shadow: 0 1px 0 rgba(255, 252, 247, 0.8);
  }
  .invite h1 {
    font-size: clamp(2.4rem, 9vw, 4.25rem);
  }
  @media (min-width: 768px) {
    .invite {
      padding: var(--space-20) 0 var(--space-24);
    }
  }
  @media (min-width: 1280px) {
    .invite h1 {
      font-size: 4.5rem;
    }
  }
</style>
