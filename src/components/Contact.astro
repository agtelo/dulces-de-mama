---
const wa = 'https://wa.me/54911XXXXXXXX?text=Hola!%20Quiero%20consultar%20por%20Dulces%20de%20Mamá';
---
<section class="section section-alt" id="contacto">
  <div class="container">
    <div class="contact-box">
      <h2>Contacto</h2>
      <p>
        Consultas, pedidos y coordinaciones solo por WhatsApp.
        Respondemos con calma, como se hacen las cosas en casa.
      </p>
      <a class="btn btn-primary" href={wa} target="_blank" rel="noopener">Abrir WhatsApp</a>
      <div class="contact-meta">
        <span>Buenos Aires · CABA y alrededores</span>
        <span>Proyecto familiar · Lotes chicos</span>
      </div>
    </div>
  </div>
</section>
