---
const wa = 'https://wa.me/54911XXXXXXXX?text=Hola!%20Quiero%20consultar%20por%20Dulces%20de%20Mamá';
---
<section class="section section-contact" id="contacto">
  <div class="container">
    <div class="contact-panel">
      <div class="contact-copy">
        <p class="section-kicker light">Contacto</p>
        <h2>Hablemos por WhatsApp</h2>
        <p>
          Consultas, pedidos y coordinaciones.
          Respondemos con calma, como se hacen las cosas en casa.
        </p>
        <ul class="contact-meta">
          <li>Buenos Aires · CABA y alrededores</li>
          <li>Proyecto familiar · Lotes chicos</li>
        </ul>
      </div>
      <div class="contact-action">
        <a class="btn btn-on-dark btn-lg" href={wa} target="_blank" rel="noopener">Abrir WhatsApp</a>
      </div>
    </div>
  </div>
</section>
