---
const base = import.meta.env.BASE_URL;
---
<section class="mx-auto max-w-md px-5 pb-10">
  <figure class="overflow-hidden rounded-xl border border-line shadow-[0_4px_20px_rgba(44,33,24,0.08)]">
    <img
      src={`${base}img/foto-producto.jpg`}
      alt="Frasco de mermelada de frutilla casera sobre mesa de madera, con cuchara y frutillas frescas"
      width="560"
      height="747"
      loading="lazy"
      class="aspect-[3/4] w-full object-cover"
    />
  </figure>
  <figcaption class="mt-2.5 text-center text-sm italic text-muted">
    Cada frasco sale de la cocina de mamá
  </figcaption>
</section>
