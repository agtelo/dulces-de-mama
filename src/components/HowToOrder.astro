---
const wa = 'https://wa.me/54911XXXXXXXX?text=Hola!%20Quiero%20conocer%20los%20Dulces%20de%20Mamá';
const steps = [
  'Escribime por WhatsApp y contame qué sabores te gustan',
  'Te confirmo disponibilidad y precio del lote',
  'Coordinamos entrega o punto de encuentro en Buenos Aires',
  'Recibís tu frasco con el mismo cariño con el que fue preparado',
];
---
<section class="section" id="pedir">
  <div class="container">
    <div class="section-head">
      <h2>¿Cómo pedir?</h2>
      <p>Simple y personal, como todo lo que hacemos.</p>
    </div>
    <ol class="steps">
      {steps.map((s) => <li>{s}</li>)}
    </ol>
    <div style="text-align:center">
      <a class="btn btn-primary" href={wa} target="_blank" rel="noopener">Escribir por WhatsApp</a>
    </div>
  </div>
</section>
