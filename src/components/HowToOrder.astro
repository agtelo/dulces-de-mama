---
const wa = 'https://wa.me/54911XXXXXXXX?text=Hola!%20Quiero%20conocer%20los%20Dulces%20de%20Mamá';
const steps = [
  'Escribime por WhatsApp y contame qué sabores te gustan',
  'Te confirmo disponibilidad y precio del lote',
  'Coordinamos entrega o punto de encuentro en Buenos Aires',
  'Recibís tu frasco con el mismo cariño con el que fue preparado',
];
---
<section class="mx-auto max-w-md px-5 py-11 text-center">
  <h2 class="font-display mb-2 text-[clamp(2rem,6vw,2.5rem)] font-bold tracking-wide text-berry">
    ¿Cómo pedir?
  </h2>
  <p class="mb-5 text-muted">Simple y personal, como todo lo que hacemos.</p>
  <ol class="mx-auto mb-7 max-w-sm list-none space-y-3.5 text-left">
    {steps.map((s, i) => (
      <li class="relative pl-9 text-[0.98rem] leading-snug text-muted">
        <span class="font-display absolute left-0 top-0 flex h-[1.65rem] w-[1.65rem] items-center justify-center rounded-full bg-berry text-[1.05rem] font-bold text-white-soft">
          {i + 1}
        </span>
        {s}
      </li>
    ))}
  </ol>
  <a
    href={wa}
    target="_blank"
    rel="noopener"
    class="inline-flex min-h-[52px] items-center justify-center gap-1.5 rounded-full bg-berry px-8 py-3 font-semibold text-white-soft transition hover:-translate-y-0.5 hover:bg-berry-hover focus-visible:outline focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-peach"
  >
    Escribir por WhatsApp <span aria-hidden="true">→</span>
  </a>
</section>
