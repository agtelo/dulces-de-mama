---
const wa = 'https://wa.me/54911XXXXXXXX?text=Hola!%20Quiero%20conocer%20los%20Dulces%20de%20Mamá';
const steps = [
  { title: 'Escribime', text: 'Contame qué sabores te gustan por WhatsApp' },
  { title: 'Confirmamos', text: 'Te digo disponibilidad y precio del lote' },
  { title: 'Coordinamos', text: 'Entrega o punto de encuentro en Buenos Aires' },
  { title: 'Recibís', text: 'Tu frasco con el mismo cariño con el que fue hecho' },
];
---
<section class="section" id="pedir">
  <div class="container">
    <div class="section-head">
      <p class="section-kicker">Simple</p>
      <h2>¿Cómo pedir?</h2>
      <p>Personal, como todo lo que hacemos.</p>
    </div>
    <ol class="steps-grid">
      {steps.map((s, i) => (
        <li class="step-card">
          <span class="step-num" aria-hidden="true">{i + 1}</span>
          <strong>{s.title}</strong>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
    <div class="section-cta">
      <a class="btn btn-primary btn-lg" href={wa} target="_blank" rel="noopener">Escribir por WhatsApp</a>
    </div>
  </div>
</section>
