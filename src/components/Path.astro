---
const wa =
  'https://wa.me/5491131547166?text=' +
  encodeURIComponent('Hola! Quiero pedir Dulces de Mamá');

const steps = [
  {
    n: '1',
    title: 'Me escribís',
    text: 'Por WhatsApp, decime qué sabor querés (o preguntá qué hay).',
  },
  {
    n: '2',
    title: 'Te confirmo',
    text: 'Stock, precio final y si preferís retiro o envío.',
  },
  {
    n: '3',
    title: 'Coordinamos',
    text: 'Retiro por zona o envío a convenir. Transferencia o Mercado Pago.',
  },
];
---

<section class="path" id="pedir">
  <div class="container">
    <div class="path-head">
      <p class="path-kicker">Sin carrito ni registro</p>
      <h2>Cómo se pide</h2>
      <p>Todo se resuelve hablando. Como entre conocidos.</p>
    </div>
    <ol class="path-steps">
      {steps.map((s) => (
        <li class="path-step">
          <span class="path-num" aria-hidden="true">{s.n}</span>
          <div>
            <strong>{s.title}</strong>
            <p>{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
    <div class="path-extra">
      <p>
        <strong>Retiro:</strong> a coordinar en CABA / GBA.
        <strong> Envío:</strong> cadete o moto a convenir.
      </p>
      <p>
        <strong>Pago:</strong> transferencia o Mercado Pago cuando confirmamos el pedido.
      </p>
    </div>
    <div class="path-cta">
      <a class="btn btn-primary btn-lg" href={wa} target="_blank" rel="noopener">Escribime por WhatsApp</a>
    </div>
  </div>
</section>
