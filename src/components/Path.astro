---
const wa =
  'https://wa.me/5491131547166?text=' +
  encodeURIComponent('Hola! Quiero pedir Dulces de Mamá');

const steps = [
  {
    n: '1',
    title: 'Me escribís',
    text: 'Por WhatsApp, decime qué sabor querés (o preguntá qué hay).',
  },
  {
    n: '2',
    title: 'Te confirmo',
    text: 'Stock, precio final y si preferís retiro o envío.',
  },
  {
    n: '3',
    title: 'Coordinamos',
    text: 'Retiro por zona o envío a convenir. Transferencia o Mercado Pago.',
  },
];
---

<section class="path" id="pedir">
  <div class="container">
    <div class="path-head">
      <p class="path-kicker">Sin carrito ni registro</p>
      <h2>Cómo se pide</h2>
      <p>Todo se resuelve hablando. Como entre conocidos. Suelo responder en el día.</p>
    </div>
    <ol class="path-steps">
      {steps.map((s) => (
        <li class="path-step path-card">
          <div class="path-label-bar" aria-hidden="true"></div>
          <div class="path-step-body">
            <span class="path-num" aria-hidden="true">{s.n}</span>
            <div>
              <strong>{s.title}</strong>
              <p>{s.text}</p>
            </div>
          </div>
        </li>
      ))}
    </ol>
    <div class="path-extra path-card">
      <div class="path-label-bar" aria-hidden="true"></div>
      <div class="path-extra-body">
        <p>
          <strong>Retiro:</strong> a coordinar en CABA / GBA.
          <strong> Envío:</strong> cadete o moto a convenir.
        </p>
        <p>
          <strong>Pago:</strong> transferencia o Mercado Pago cuando confirmamos.
        </p>
      </div>
    </div>
    <div class="path-cta">
      <a class="btn btn-primary btn-lg" href={wa} target="_blank" rel="noopener">
        Escribime por WhatsApp
      </a>
      <p class="path-hint">Se abre WhatsApp · +54 9 11 3154-7166</p>
    </div>
  </div>
</section>

<style>
  .path-card {
    display: grid;
    grid-template-columns: 8px 1fr;
    gap: 0;
    padding: 0;
    overflow: hidden;
    background: var(--paper);
    border: 2px solid var(--line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }
  .path-label-bar {
    background: var(--berry);
    min-height: 100%;
  }
  .path-step-body {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-5);
    align-items: start;
    padding: var(--space-6);
  }
  .path-extra-body {
    padding: var(--space-5) var(--space-6);
  }
  .path-extra-body p + p {
    margin-top: 0.5rem;
  }
  .path-step.path-card {
    grid-template-columns: 8px 1fr;
  }
  .path-hint {
    margin-top: var(--space-3);
    font-size: 0.88rem;
    color: #4a3a30;
  }
</style>
