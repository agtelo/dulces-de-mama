---
const base = import.meta.env.BASE_URL;
const wa = 'https://wa.me/54911XXXXXXXX?text=Hola!%20Quiero%20pedir%20Dulces%20de%20Mamá';
---

<section class="hero" id="inicio">
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="hero-badge">Hecho con amor en casa</span>
      <h1>El sabor de la<br />cocina de mamá</h1>
      <p class="hero-lead">
        Mermeladas en lotes chicos, con fruta de temporada y el tiempo justo.
        Sin conservantes. Solo cariño.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={wa} target="_blank" rel="noopener">Pedir por WhatsApp</a>
        <a class="btn btn-ghost" href="#sabores">Ver sabores</a>
      </div>
      <ul class="hero-trust" aria-label="Confianza">
        <li>Lotes chicos</li>
        <li>100% natural</li>
        <li>CABA y alrededores</li>
      </ul>
    </div>
    <div class="hero-media">
      <figure class="hero-frame">
        <img
          src={`${base}img/foto-producto.jpg`}
          alt="Frasco de mermelada de frutilla casera sobre mesa de madera"
          width="640"
          height="853"
          fetchpriority="high"
        />
        <figcaption>Cada frasco sale de la cocina de mamá</figcaption>
      </figure>
    </div>
  </div>
</section>
