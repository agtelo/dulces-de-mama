---
const base = import.meta.env.BASE_URL;
const wa = 'https://wa.me/54911XXXXXXXX?text=Hola!%20Quiero%20pedir%20Dulces%20de%20Mamá';
---

<section class="hero" id="inicio">
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="hero-badge">Hecho con amor en casa</span>
      <h1>El sabor de la cocina de mamá</h1>
      <p class="hero-lead">
        Mermeladas y dulces en lotes chicos, con fruta de temporada y el tiempo justo.
        Sin conservantes. Solo cariño.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={wa} target="_blank" rel="noopener">Pedir por WhatsApp</a>
        <a class="btn btn-ghost" href="#sabores">Ver sabores</a>
      </div>
    </div>
    <div class="hero-media">
      <figure>
        <img
          src={`${base}img/foto-producto.jpg`}
          alt="Frasco de mermelada de frutilla casera sobre mesa de madera"
          width="560"
          height="747"
          fetchpriority="high"
        />
      </figure>
      <figcaption>Cada frasco sale de la cocina de mamá</figcaption>
    </div>
  </div>
</section>
