---
const values = [
  { title: 'Amor familiar', text: 'El mismo cariño que se pone en la mesa de casa' },
  { title: '100% natural', text: 'Fruta + azúcar + tiempo. Nada más' },
  { title: 'Lotes chicos', text: 'Control total del proceso, frasco a frasco' },
  { title: 'Cercanía', text: 'Solo para amigos y conocidos' },
];
---
<section class="section section-kraft" id="valores">
  <div class="container">
    <div class="section-head">
      <h2>Lo que nos define</h2>
    </div>
    <div class="value-grid">
      {values.map((v) => (
        <div class="value-card">
          <strong>{v.title}</strong>
          <span>{v.text}</span>
        </div>
      ))}
    </div>
  </div>
</section>
