---
const values = [
  { title: 'Amor familiar', text: 'El mismo cariño que se pone en la mesa de casa', tone: 'berry' },
  { title: '100% natural', text: 'Fruta + azúcar + tiempo. Nada más', tone: 'peach' },
  { title: 'Lotes chicos', text: 'Control total del proceso, frasco a frasco', tone: 'kraft' },
  { title: 'Cercanía', text: 'Solo para amigos y conocidos', tone: 'ink' },
];
---
<section class="section section-values" id="valores">
  <div class="container">
    <div class="section-head">
      <p class="section-kicker">Por qué nos eligen</p>
      <h2>Lo que nos define</h2>
    </div>
    <div class="value-grid">
      {values.map((v) => (
        <article class={`value-card tone-${v.tone}`}>
          <strong>{v.title}</strong>
          <span>{v.text}</span>
        </article>
      ))}
    </div>
  </div>
</section>
