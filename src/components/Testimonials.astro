---
const items = [
  {
    quote: 'La de frutilla es igual a la que hacía mi abuela. Pedí tres frascos y se fueron en una semana.',
    author: 'Laura',
    place: 'Palermo',
  },
  {
    quote: 'Se nota que está hecha con tiempo. El membrillo es el mejor que probé en mucho tiempo.',
    author: 'Martín',
    place: 'Villa Crespo',
  },
  {
    quote: 'Pedí para regalar y terminé quedándome con uno. Es el sabor de casa, de verdad.',
    author: 'Sofía',
    place: 'Caballito',
  },
];
---
<section class="section section-alt" id="amigos">
  <div class="container">
    <div class="section-head">
      <p class="section-kicker">Círculo cercano</p>
      <h2>Lo que dicen los amigos</h2>
    </div>
    <div class="testimonial-grid">
      {items.map((t) => (
        <blockquote class="testimonial">
          <p>“{t.quote}”</p>
          <footer>
            <cite>{t.author}</cite>
            <span>{t.place}</span>
          </footer>
        </blockquote>
      ))}
    </div>
  </div>
</section>
