---
const items = [
  {
    quote: 'La de frutilla es igual a la que hacía mi abuela. Pedí tres frascos y se fueron en una semana.',
    author: 'Laura, Palermo',
  },
  {
    quote: 'Se nota que está hecha con tiempo. El membrillo es el mejor que probé en mucho tiempo.',
    author: 'Martín, Villa Crespo',
  },
  {
    quote: 'Pedí para regalar y terminé quedándome con uno. Es el sabor de casa, de verdad.',
    author: 'Sofía, Caballito',
  },
];
---
<section class="border-y border-line bg-paper px-5 py-11">
  <h2 class="font-display mb-6 text-center text-[clamp(2rem,6vw,2.5rem)] font-bold tracking-wide text-berry">
    Lo que dicen los amigos
  </h2>
  <div class="mx-auto flex max-w-lg flex-col gap-4.5">
    {items.map((t) => (
      <blockquote class="rounded-[10px] border border-line bg-white-soft px-5 py-4">
        <p class="mb-2 text-[0.98rem] italic leading-relaxed text-ink">
          “{t.quote}”
        </p>
        <cite class="text-sm font-semibold not-italic text-muted">— {t.author}</cite>
      </blockquote>
    ))}
  </div>
</section>
