---
const flavors = [
  { name: 'Frutilla', desc: 'Clásica, intensa, con trocitos de fruta', status: 'ok' },
  { name: 'Durazno', desc: 'Suave y aromática, ideal para el desayuno', status: 'ok' },
  { name: 'Membrillo', desc: 'Tradicional y sedoso', status: 'ok' },
  { name: 'Naranja', desc: 'Cítrica y equilibrada, perfecta con queso', status: 'soon' },
  { name: 'Frutos Rojos', desc: 'Mezcla de berries de temporada', status: 'soon' },
  { name: 'Manzana', desc: 'Con canela, sabor de otoño', status: 'soon' },
];
---
<section class="section" id="sabores">
  <div class="container">
    <div class="section-head">
      <h2>Sabores</h2>
      <p>Ahora tenemos frutilla, durazno y membrillo. El resto según temporada.</p>
    </div>
    <ul class="flavor-list">
      {flavors.map((f) => (
        <li class="flavor-item">
          <span class="flavor-name">{f.name}</span>
          <span class={`badge ${f.status === 'ok' ? 'badge-ok' : 'badge-soon'}`}>
            {f.status === 'ok' ? 'Disponible' : 'Próximamente'}
          </span>
          <span class="flavor-desc">{f.desc}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
