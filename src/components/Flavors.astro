---
const flavors = [
  { name: 'Frutilla', desc: 'Clásica, intensa, con trocitos de fruta', status: 'ok', tone: 'berry' },
  { name: 'Durazno', desc: 'Suave y aromática, ideal para el desayuno', status: 'ok', tone: 'peach' },
  { name: 'Membrillo', desc: 'Tradicional y sedoso', status: 'ok', tone: 'kraft' },
  { name: 'Naranja', desc: 'Cítrica y equilibrada, perfecta con queso', status: 'soon', tone: 'cream' },
  { name: 'Frutos Rojos', desc: 'Mezcla de berries de temporada', status: 'soon', tone: 'berry' },
  { name: 'Manzana', desc: 'Con canela, sabor de otoño', status: 'soon', tone: 'kraft' },
];
---
<section class="section" id="sabores">
  <div class="container">
    <div class="section-head">
      <p class="section-kicker">Temporada</p>
      <h2>Sabores</h2>
      <p>Ahora: frutilla, durazno y membrillo. El resto según la fruta.</p>
    </div>
    <ul class="flavor-grid">
      {flavors.map((f) => (
        <li class={`flavor-card tone-${f.tone}`}>
          <div class="flavor-card-top">
            <span class="flavor-name">{f.name}</span>
            <span class={`badge ${f.status === 'ok' ? 'badge-ok' : 'badge-soon'}`}>
              {f.status === 'ok' ? 'Disponible' : 'Próximamente'}
            </span>
          </div>
          <p class="flavor-desc">{f.desc}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
