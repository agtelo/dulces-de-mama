---
/** Precios orientativos del frasco 360 g. Confirmamos por WhatsApp. */
const phone = '5491131547166';
const flavors = [
  {
    name: 'Frutilla',
    note: 'Intensa, con trocitos',
    pair: 'Tostadas, yogurt o facturas',
    price: 9500,
    on: true,
  },
  {
    name: 'Durazno',
    note: 'Suave, de desayuno',
    pair: 'Mate y pan casero',
    price: 9000,
    on: true,
  },
  {
    name: 'Membrillo',
    note: 'Tradicional y sedoso',
    pair: 'Queso fresco o postre',
    price: 9000,
    on: true,
  },
  {
    name: 'Naranja',
    note: 'Cítrica, ideal con queso',
    pair: 'Budín o tabla de quesos',
    price: 9500,
    on: false,
  },
  {
    name: 'Frutos rojos',
    note: 'Cuando hay berries',
    pair: 'Yogurt o helado',
    price: 11000,
    on: false,
  },
  {
    name: 'Manzana',
    note: 'Con canela, de otoño',
    pair: 'Tostadas o postre caliente',
    price: 9000,
    on: false,
  },
];

const listed = [...flavors].sort((a, b) => Number(b.on) - Number(a.on));
const hasAny = listed.some((f) => f.on);

const formatPrice = (n: number) =>
  new Intl.NumberFormat('es-AR', {
    style: 'currency',
    currency: 'ARS',
    maximumFractionDigits: 0,
  }).format(n);

const waRestock =
  `https://wa.me/${phone}?text=${encodeURIComponent('Hola! Avisame cuando haya stock de Dulces de Mamá')}`;
---

<section class="season" id="temporada">
  <div class="container">
    <div class="season-head">
      <p class="season-kicker">Esta temporada</p>
      <h2>Lo que hay ahora en la cocina</h2>
      <p>
        Precio de referencia del frasco 360 g. En el pedido elegís medida y
        cantidad. Lo confirmamos por WhatsApp.
      </p>
      <p class="season-updated">Lista actualizada: agosto 2026</p>
    </div>

    {
      !hasAny && (
        <div class="season-empty" role="status">
          <p>
            Esta semana estoy sin stock. Escribime y te aviso la próxima tanda.
          </p>
          <a class="btn btn-primary" href={waRestock} target="_blank" rel="noopener">
            Avisame cuando haya
          </a>
        </div>
      )
    }

    <ul class="season-list">
      {listed.map((f) => (
        <li class={`season-item ${f.on ? 'is-on' : 'is-off'}`}>
          <div class="season-label-bar" aria-hidden="true"></div>
          <div class="season-body">
            <div class="season-top">
              <span class="season-name">{f.name}</span>
              <span class={`season-status ${f.on ? 'on' : 'off'}`}>
                {f.on ? 'Hay' : 'Después'}
              </span>
            </div>
            <p class="season-note">{f.note}</p>
            <p class="season-pair">{f.pair}</p>
            <div class="season-footer">
              <p class="season-price">{formatPrice(f.price)}</p>
              {
                f.on ? (
                  <button
                    type="button"
                    class="season-order"
                    data-add-flavor={f.name}
                    data-add-price={f.price}
                  >
                    Agregar
                  </button>
                ) : (
                  <span class="season-order is-muted">Pronto</span>
                )
              }
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .season-item {
    display: grid;
    grid-template-columns: 8px 1fr;
    gap: 0;
    padding: 0;
    overflow: hidden;
    background: var(--paper);
    border: 2px solid var(--line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }
  .season-label-bar {
    background: var(--berry);
    min-height: 100%;
  }
  .season-item.is-off .season-label-bar {
    background: var(--kraft-deep);
  }
  .season-body {
    padding: var(--space-5);
  }
  .season-pair {
    font-size: 0.88rem;
    color: var(--muted);
    font-weight: 500;
    font-style: italic;
    margin-bottom: 0.4rem;
  }
  .season-pair::before {
    content: 'Con qué va · ';
    font-style: normal;
    font-weight: 600;
    color: var(--peach);
  }
  .season-updated {
    margin-top: var(--space-3);
    font-size: 0.85rem;
    color: var(--muted);
  }
  .season-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: 0.35rem;
  }
  .season-order {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--berry);
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
    touch-action: manipulation;
    background: none;
    border: 0;
    cursor: pointer;
    font-family: inherit;
  }
  .season-order:hover {
    color: var(--berry-hover);
  }
  .season-order.is-muted {
    color: var(--muted);
    text-decoration: none;
    font-weight: 600;
    cursor: default;
  }
  .season-empty {
    max-width: 40rem;
    margin: 0 auto var(--space-8);
    padding: var(--space-6);
    text-align: center;
    background: var(--paper);
    border: 2px dashed var(--line);
    border-radius: var(--radius-md);
  }
  .season-empty p {
    color: var(--muted);
    margin-bottom: var(--space-5);
  }
</style>

<script is:inline>
  document.querySelectorAll('[data-add-flavor]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      window.dispatchEvent(
        new CustomEvent('ddm-add', {
          detail: {
            flavor: btn.getAttribute('data-add-flavor'),
            price: parseFloat(btn.getAttribute('data-add-price')),
            qty: 1,
          },
        })
      );
    });
  });
</script>
