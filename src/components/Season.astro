---
/**
 * Precios orientativos (frasco ~350–400 g).
 * Referencia mercado AR reciente:
 * - Supermercado industrial ~$2.000–$6.000
 * - Artesanal de marca (El Brocal, Las Quinas, etc.) ~$7.000–$11.000
 * - Casero / feria / lote chico: suele ir de $8.000 a $12.000+
 * Posicionamos Dulces de Mamá en el rango casero cercano.
 */
const flavors = [
  {
    name: 'Frutilla',
    note: 'Intensa, con trocitos',
    price: 9500,
    on: true,
    img: 'https://images.unsplash.com/photo-1464965911861-746a04b4bca6?w=400&h=400&fit=crop&q=80',
    alt: 'Frutillas frescas',
  },
  {
    name: 'Durazno',
    note: 'Suave, de desayuno',
    price: 9000,
    on: true,
    img: 'https://images.unsplash.com/photo-1629828874514-8c0f3b8a8b0f?w=400&h=400&fit=crop&q=80',
    alt: 'Duraznos',
  },
  {
    name: 'Membrillo',
    note: 'Tradicional y sedoso',
    price: 9000,
    on: true,
    img: 'https://images.unsplash.com/photo-1587049352851-8d4e89133924?w=400&h=400&fit=crop&q=80',
    alt: 'Dulce en frasco',
  },
  {
    name: 'Naranja',
    note: 'Cítrica, ideal con queso',
    price: 9500,
    on: false,
    img: 'https://images.unsplash.com/photo-1547514701-42782101795e?w=400&h=400&fit=crop&q=80',
    alt: 'Naranjas',
  },
  {
    name: 'Frutos rojos',
    note: 'Cuando hay berries',
    price: 11000,
    on: false,
    img: 'https://images.unsplash.com/photo-1563746098251-dfb89bd6a1f4?w=400&h=400&fit=crop&q=80',
    alt: 'Frutos rojos',
  },
  {
    name: 'Manzana',
    note: 'Con canela, de otoño',
    price: 9000,
    on: false,
    img: 'https://images.unsplash.com/photo-1560806887-1e4cd0b21ca2?w=400&h=400&fit=crop&q=80',
    alt: 'Manzanas',
  },
];

const formatPrice = (n: number) =>
  new Intl.NumberFormat('es-AR', {
    style: 'currency',
    currency: 'ARS',
    maximumFractionDigits: 0,
  }).format(n);
---

<section class="season" id="temporada">
  <div class="container">
    <div class="season-head">
      <p class="season-kicker">Esta temporada</p>
      <h2>Lo que hay ahora en la cocina</h2>
      <p>
        Frasco de vidrio ~350–400 g. Precios orientativos; confirmamos por WhatsApp.
      </p>
    </div>
    <ul class="season-list">
      {flavors.map((f) => (
        <li class={`season-item ${f.on ? 'is-on' : 'is-off'}`}>
          <div class="season-media">
            <img src={f.img} alt={f.alt} width="96" height="96" loading="lazy" />
          </div>
          <div class="season-body">
            <div class="season-top">
              <span class="season-name">{f.name}</span>
              <span class={`season-status ${f.on ? 'on' : 'off'}`}>
                {f.on ? 'Hay' : 'Después'}
              </span>
            </div>
            <p class="season-note">{f.note}</p>
            <p class="season-price">{formatPrice(f.price)}</p>
          </div>
        </li>
      ))}
    </ul>
    <p class="season-footnote">
      Referencia mercado: industrial ~$2–6 mil · artesanal de marca ~$7–11 mil ·
      casero / lote chico suele ir de $8 a $12 mil el frasco.
    </p>
  </div>
</section>
