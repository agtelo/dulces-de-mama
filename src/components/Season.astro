---
/** Precios orientativos (frasco ~350–400 g). Confirmamos por WhatsApp. */
const flavors = [
  {
    name: 'Frutilla',
    note: 'Intensa, con trocitos',
    pair: 'Tostadas, yogurt o facturas',
    price: 9500,
    on: true,
  },
  {
    name: 'Durazno',
    note: 'Suave, de desayuno',
    pair: 'Mate y pan casero',
    price: 9000,
    on: true,
  },
  {
    name: 'Membrillo',
    note: 'Tradicional y sedoso',
    pair: 'Queso fresco o postre',
    price: 9000,
    on: true,
  },
  {
    name: 'Naranja',
    note: 'Cítrica, ideal con queso',
    pair: 'Budín o tabla de quesos',
    price: 9500,
    on: false,
  },
  {
    name: 'Frutos rojos',
    note: 'Cuando hay berries',
    pair: 'Yogurt o helado',
    price: 11000,
    on: false,
  },
  {
    name: 'Manzana',
    note: 'Con canela, de otoño',
    pair: 'Tostadas o postre caliente',
    price: 9000,
    on: false,
  },
];

const formatPrice = (n: number) =>
  new Intl.NumberFormat('es-AR', {
    style: 'currency',
    currency: 'ARS',
    maximumFractionDigits: 0,
  }).format(n);
---

<section class="season" id="temporada">
  <div class="container">
    <div class="season-head">
      <p class="season-kicker">Esta temporada</p>
      <h2>Lo que hay ahora en la cocina</h2>
      <p>
        Frasco de vidrio ~350–400 g. Precios orientativos: los confirmamos por
        WhatsApp. La fruta manda; si no hay, la próxima tanda te aviso.
      </p>
    </div>
    <ul class="season-list">
      {flavors.map((f) => (
        <li class={`season-item ${f.on ? 'is-on' : 'is-off'}`}>
          <div class="season-label-bar" aria-hidden="true"></div>
          <div class="season-body">
            <div class="season-top">
              <span class="season-name">{f.name}</span>
              <span class={`season-status ${f.on ? 'on' : 'off'}`}>
                {f.on ? 'Hay' : 'Después'}
              </span>
            </div>
            <p class="season-note">{f.note}</p>
            <p class="season-pair">{f.pair}</p>
            <p class="season-price">{formatPrice(f.price)}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Cards tipo etiqueta de frasco */
  .season-item {
    display: grid;
    grid-template-columns: 8px 1fr;
    gap: 0;
    padding: 0;
    overflow: hidden;
    background: var(--paper);
    border: 2px solid var(--line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }
  .season-label-bar {
    background: var(--berry);
    min-height: 100%;
  }
  .season-item.is-off .season-label-bar {
    background: var(--kraft-deep);
  }
  .season-body {
    padding: var(--space-5) var(--space-5) var(--space-5) var(--space-5);
  }
  .season-pair {
    font-size: 0.88rem;
    color: var(--muted);
    font-weight: 500;
    font-style: italic;
    margin-bottom: 0.4rem;
  }
  .season-pair::before {
    content: 'Con qué va · ';
    font-style: normal;
    font-weight: 600;
    color: var(--peach);
  }
</style>
