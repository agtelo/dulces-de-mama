---
const voices = [
  {
    text: 'La de frutilla se parece a la de mi abuela. Pedí tres y se fueron en una semana.',
    who: 'Laura',
    where: 'Palermo',
  },
  {
    text: 'El membrillo con queso es un vicio. Se nota que está hecho con tiempo.',
    who: 'Martín',
    where: 'Villa Crespo',
  },
  {
    text: 'Pedí para regalar y me quedé con uno. Sabor de casa de verdad.',
    who: 'Sofía',
    where: 'Caballito',
  },
];
---

<section class="voices" id="voces">
  <div class="container">
    <div class="voices-head">
      <p class="voices-kicker">De la mesa de otros</p>
      <h2>Lo que cuentan los amigos</h2>
      <p class="voices-lead">Frases de gente conocida. Cuando tengas las tuyas, las cambiamos.</p>
    </div>
    <div class="voices-grid">
      {voices.map((v) => (
        <blockquote class="voice voice-card">
          <div class="voice-label-bar" aria-hidden="true"></div>
          <div class="voice-body">
            <p>“{v.text}”</p>
            <footer>
              <cite>{v.who}</cite>
              <span>{v.where}</span>
            </footer>
          </div>
        </blockquote>
      ))}
    </div>
  </div>
</section>

<style>
  .voice-card {
    display: grid;
    grid-template-columns: 8px 1fr;
    gap: 0;
    padding: 0;
    overflow: hidden;
    background: var(--paper);
    border: 2px solid var(--line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }
  .voice-label-bar {
    background: var(--peach);
    min-height: 100%;
  }
  .voice-body {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .voice-body footer {
    border-top: 2px solid var(--line);
    padding-top: var(--space-4);
  }
</style>
