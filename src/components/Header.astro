---
const base = import.meta.env.BASE_URL;
---
<header class="bg-paper border-b border-line pt-5 pb-3.5 px-5 text-center">
  <div class="mx-auto mb-1 w-[min(130px,36vw)]">
    <img
      src={`${base}img/logo-principal-v2.jpg`}
      alt="Dulces de Mamá"
      width="130"
      height="195"
      class="w-full rounded-sm"
    />
  </div>
  <p class="font-display text-[1.35rem] font-bold tracking-wide text-berry">
    Hecho con amor en casa
  </p>
</header>
