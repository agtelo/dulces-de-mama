---
const base = import.meta.env.BASE_URL;
const wa = 'https://wa.me/54911XXXXXXXX?text=Hola!%20Quiero%20pedir%20Dulces%20de%20Mamá';
---

<header class="nav">
  <div class="container nav-inner">
    <a href="#inicio" class="nav-brand">
      <img src={`${base}img/logo-principal-v2.jpg`} alt="" width="48" height="48" />
      <span>Dulces de Mamá</span>
    </a>

    <nav class="nav-links" aria-label="Principal">
      <a href="#frasco">El frasco</a>
      <a href="#temporada">Temporada</a>
      <a href="#pedir">Cómo pedir</a>
      <a href="#puerta">Escribime</a>
    </nav>

    <a class="btn btn-primary nav-cta" href={wa} target="_blank" rel="noopener">WhatsApp</a>

    <button
      class="nav-toggle"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="nav-panel"
      id="nav-toggle"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <div class="nav-panel" id="nav-panel" hidden>
    <a href="#frasco">El frasco</a>
    <a href="#temporada">Temporada</a>
    <a href="#pedir">Cómo pedir</a>
    <a href="#puerta">Escribime</a>
    <a class="btn btn-primary" href={wa} target="_blank" rel="noopener">Pedir por WhatsApp</a>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('nav-panel');
  if (toggle && panel) {
    const closeMenu = () => {
      panel.classList.remove('is-open');
      panel.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Abrir menú');
    };
    const openMenu = () => {
      panel.hidden = false;
      panel.classList.add('is-open');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Cerrar menú');
    };
    toggle.addEventListener('click', () => {
      panel.classList.contains('is-open') ? closeMenu() : openMenu();
    });
    panel.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
    window.addEventListener('resize', () => {
      if (window.matchMedia('(min-width: 768px)').matches) closeMenu();
    });
  }
</script>
