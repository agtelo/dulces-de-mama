---
const base = import.meta.env.BASE_URL;
const wa =
  'https://wa.me/5491131547166?text=' +
  encodeURIComponent('Hola! Quiero pedir Dulces de Mamá');
---

<header class="nav">
  <div class="container nav-inner">
    <a href="/" class="nav-brand">
      <img
        src={`${base}img/icono-frasco.jpg`}
        alt="Logo Dulces de Mamá — frasco de mermelada"
        width="48"
        height="48"
      />
      <span class="nav-brand-text">Dulces de Mamá</span>
    </a>

    <nav class="nav-links" aria-label="Principal">
      <a href="#frasco" data-nav="frasco">Frasco</a>
      <a href="#temporada" data-nav="temporada">Temporada</a>
      <a href="#pedir" data-nav="pedir">Pedir</a>
    </nav>

    <a class="btn btn-primary nav-cta" href={wa} target="_blank" rel="noopener">Escribime</a>

    <button
      class="nav-toggle"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="nav-panel"
      id="nav-toggle"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <div class="nav-panel" id="nav-panel" hidden>
    <a href="#frasco">El frasco</a>
    <a href="#temporada">Temporada</a>
    <a href="#pedir">Cómo pedir</a>
    <a href="#puerta">Escribime</a>
    <a class="btn btn-primary" href={wa} target="_blank" rel="noopener">Escribime por WhatsApp</a>
  </div>
</header>

<style>
  .nav-links a {
    white-space: nowrap;
    flex-shrink: 0;
  }
  .nav-links a.is-active {
    color: var(--berry);
    background: var(--berry-soft);
  }
  .nav-brand {
    flex-shrink: 0;
    min-width: 0;
  }
  .nav-brand-text {
    white-space: nowrap;
  }
  .nav-cta {
    flex-shrink: 0;
    white-space: nowrap;
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .nav-inner {
      gap: 0.5rem;
      padding-inline: 1rem;
    }
    .nav-brand img {
      width: 40px;
      height: 40px;
    }
    .nav-brand-text {
      font-size: 1.2rem;
    }
    .nav-links {
      gap: 0;
    }
    .nav-links a {
      padding: 0.5rem 0.65rem;
      font-size: 0.88rem;
    }
    .nav-cta {
      min-height: 42px;
      padding: 0.5rem 1.1rem;
      font-size: 0.9rem;
    }
  }
</style>

<script is:inline>
  (function () {
    var toggle = document.getElementById('nav-toggle');
    var panel = document.getElementById('nav-panel');
    if (toggle && panel) {
      function closeMenu() {
        panel.classList.remove('is-open');
        panel.hidden = true;
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Abrir menú');
      }
      function openMenu() {
        panel.hidden = false;
        panel.classList.add('is-open');
        toggle.setAttribute('aria-expanded', 'true');
        toggle.setAttribute('aria-label', 'Cerrar menú');
      }
      toggle.addEventListener('click', function () {
        if (panel.classList.contains('is-open')) closeMenu();
        else openMenu();
      });
      panel.querySelectorAll('a').forEach(function (link) {
        link.addEventListener('click', closeMenu);
      });
      window.addEventListener('resize', function () {
        if (window.matchMedia('(min-width: 768px)').matches) closeMenu();
      });
    }

    var sections = ['frasco', 'temporada', 'pedir', 'puerta'];
    var links = document.querySelectorAll('.nav-links a[data-nav]');
    if (!links.length || !('IntersectionObserver' in window)) return;

    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          var id = entry.target.id;
          links.forEach(function (a) {
            var on = a.getAttribute('data-nav') === id;
            a.classList.toggle('is-active', on);
            if (on) a.setAttribute('aria-current', 'true');
            else a.removeAttribute('aria-current');
          });
        });
      },
      { rootMargin: '-40% 0px -45% 0px', threshold: 0 }
    );

    sections.forEach(function (id) {
      var el = document.getElementById(id);
      if (el) observer.observe(el);
    });
  })();
</script>
