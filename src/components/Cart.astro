---
const phone = '5491131547166';
const base = import.meta.env.BASE_URL;
const flavors = [
  { name: 'Frutilla', price: 9500, on: true },
  { name: 'Durazno', price: 9000, on: true },
  { name: 'Membrillo', price: 9000, on: true },
  { name: 'Naranja', price: 9500, on: false },
  { name: 'Frutos rojos', price: 11000, on: false },
  { name: 'Manzana', price: 9000, on: false },
];
const sizes = [
  { id: '250', label: '250 g', note: 'Chico, para probar', factor: 0.75, img: `${base}img/frasco-250.svg` },
  { id: '360', label: '360 g', note: 'El de siempre', factor: 1, img: `${base}img/frasco-360.svg` },
  { id: '500', label: '500 g', note: 'Para la mesa', factor: 1.35, img: `${base}img/frasco-500.svg` },
];
---

<section class="cart" id="pedido" data-phone={phone}>
  <div class="container">
    <div class="cart-head">
      <p class="cart-kicker">Armá tu pedido</p>
      <h2>Elegí sabor, frasco y cantidad.</h2>
      <p>
        No es un checkout: armás el mensaje y se abre WhatsApp. El precio es
        orientativo; lo confirmamos juntas.
      </p>
    </div>

    <div class="cart-board">
      <fieldset class="cart-block">
        <legend>1. Elegí el frasco</legend>
        <div class="cart-sizes" role="radiogroup" aria-label="Medida del frasco">
          {sizes.map((s, i) => (
            <label class={`cart-jar ${i === 1 ? 'is-on' : ''}`}>
              <input
                type="radio"
                name="jar-size"
                value={s.id}
                data-label={s.label}
                data-factor={s.factor}
                checked={i === 1}
              />
              <img src={s.img} alt={`Frasco de ${s.label}`} width="160" height="200" />
              <span class="cart-jar-label">{s.label}</span>
              <span class="cart-jar-note">{s.note}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset class="cart-block">
        <legend>2. Tipo de mermelada</legend>
        <div class="cart-flavors" role="radiogroup" aria-label="Sabor">
          {flavors.map((f, i) => (
            <label class={`cart-choice ${!f.on ? 'is-off' : ''} ${f.on && i === 0 ? 'is-on' : ''}`}>
              <input
                type="radio"
                name="jar-flavor"
                value={f.name}
                data-price={f.price}
                disabled={!f.on}
                checked={f.on && i === 0}
              />
              <span class="cart-choice-title">{f.name}</span>
              <span class="cart-choice-note">{f.on ? 'Hay' : 'Después'}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset class="cart-block cart-qty-block">
        <legend>3. Cantidad</legend>
        <div class="cart-qty">
          <button type="button" class="cart-qty-btn" data-qty="-" aria-label="Menos">−</button>
          <input id="cart-qty" type="number" min="1" max="4" value="1" inputmode="numeric" />
          <button type="button" class="cart-qty-btn" data-qty="+" aria-label="Más">+</button>
        </div>
        <p class="cart-qty-hint">Hasta 4 frascos por tanda.</p>
      </fieldset>

      <button type="button" class="btn btn-ghost" id="cart-add">Agregar al pedido</button>

      <div class="cart-list-wrap">
        <h3>Tu pedido</h3>
        <ul class="cart-list" id="cart-list"></ul>
        <p class="cart-empty" id="cart-empty">Todavía no agregaste nada.</p>
        <p class="cart-total" id="cart-total" hidden></p>
      </div>

      <label class="cart-gift">
        <input type="checkbox" id="cart-gift" />
        Es para regalo
      </label>

      <label class="cart-note-label" for="cart-note">Nota (opcional)</label>
      <textarea
        id="cart-note"
        rows="2"
        maxlength="180"
        placeholder="Ej. retiro por Palermo el sábado"
      ></textarea>

      <a
        class="btn btn-primary btn-lg"
        id="cart-wa"
        href={`https://wa.me/${phone}?text=${encodeURIComponent('Hola! Quiero pedir Dulces de Mamá')}`}
        target="_blank"
        rel="noopener"
      >
        Enviar pedido por WhatsApp
      </a>
      <p class="cart-hint">Se abre WhatsApp con el detalle · sin compromiso</p>
    </div>
  </div>
</section>

<style>
  .cart {
    padding: var(--space-16) 0 var(--space-20);
    background: var(--paper);
    border-block: 2px solid var(--line);
  }
  .cart-head {
    text-align: center;
    max-width: var(--container);
    margin: 0 auto var(--space-10);
  }
  .cart-kicker {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--peach);
    background: var(--peach-soft);
    padding: 0.45rem 1rem;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-4);
  }
  .cart-head h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.2rem, 5.5vw, 3rem);
    color: var(--berry);
    margin-bottom: var(--space-3);
    line-height: 1.1;
  }
  .cart-head p { color: var(--muted); }
  .cart-board {
    max-width: 44rem;
    margin: 0 auto;
    display: grid;
    gap: var(--space-6);
    padding: var(--space-8) var(--space-5);
    background: var(--cream);
    border: 2.5px solid var(--line);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
  }
  .cart-block {
    border: 0;
    min-width: 0;
  }
  .cart-block legend {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--berry);
    margin-bottom: var(--space-3);
  }
  .cart-sizes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }
  .cart-jar {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.35rem;
    padding: 0.65rem 0.4rem 0.85rem;
    background: var(--paper);
    border: 2.5px solid var(--line);
    border-radius: var(--radius-lg);
    cursor: pointer;
    touch-action: manipulation;
    position: relative;
  }
  .cart-jar input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .cart-jar img {
    width: 100%;
    max-width: 140px;
    height: auto;
    border-radius: 16px;
  }
  .cart-jar-label {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--berry);
    line-height: 1;
  }
  .cart-jar-note {
    font-size: 0.75rem;
    color: var(--muted);
    line-height: 1.3;
  }
  .cart-jar.is-on {
    border-color: var(--berry);
    background: var(--berry-soft);
    box-shadow: 0 4px 0 var(--berry);
  }
  .cart-flavors {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }
  .cart-choice {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: 0.75rem;
    padding: 0.85rem 1rem;
    background: var(--paper);
    border: 2px solid var(--line);
    border-radius: var(--radius-md);
    cursor: pointer;
    touch-action: manipulation;
  }
  .cart-choice input {
    grid-row: 1 / span 2;
    align-self: center;
    accent-color: var(--berry);
    width: 1.15rem;
    height: 1.15rem;
  }
  .cart-choice-title {
    font-weight: 700;
    color: var(--ink);
  }
  .cart-choice-note {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .cart-choice.is-on {
    border-color: var(--berry);
    background: var(--berry-soft);
  }
  .cart-choice.is-off {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .cart-qty {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .cart-qty-btn {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--kraft);
    color: var(--ink);
    font-size: 1.4rem;
    font-weight: 700;
    touch-action: manipulation;
  }
  .cart-qty-btn:hover { background: var(--kraft-deep); }
  #cart-qty {
    width: 4rem;
    height: 48px;
    text-align: center;
    font: inherit;
    font-weight: 700;
    border: 2px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--paper);
    color: var(--ink);
  }
  .cart-qty-hint {
    margin-top: 0.4rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .cart-list-wrap h3 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--berry);
    margin-bottom: var(--space-3);
  }
  .cart-list {
    display: grid;
    gap: var(--space-3);
  }
  .cart-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 0.75rem 1rem;
    background: var(--paper);
    border: 2px solid var(--line);
    border-radius: var(--radius-md);
  }
  .cart-line strong { color: var(--berry); }
  .cart-line-meta {
    font-size: 0.88rem;
    color: var(--muted);
  }
  .cart-remove {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--berry);
    text-decoration: underline;
    text-underline-offset: 2px;
    touch-action: manipulation;
  }
  .cart-empty { color: var(--muted); font-size: 0.95rem; }
  .cart-total {
    margin-top: var(--space-3);
    font-weight: 700;
    color: var(--ink);
  }
  .cart-gift {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
  }
  .cart-gift input { accent-color: var(--berry); width: 1.15rem; height: 1.15rem; }
  .cart-note-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--muted);
  }
  #cart-note {
    width: 100%;
    font: inherit;
    padding: 0.75rem 1rem;
    border: 2px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--paper);
    color: var(--ink);
    resize: vertical;
  }
  .cart-hint {
    text-align: center;
    font-size: 0.88rem;
    color: var(--muted);
  }
  #cart-add,
  #cart-wa {
    width: 100%;
  }
  @media (min-width: 640px) {
    .cart-flavors { grid-template-columns: 1fr 1fr; }
    .cart-jar-note { font-size: 0.85rem; }
  }
</style>

<script is:inline>
  (function () {
    var root = document.getElementById('pedido');
    if (!root) return;
    var phone = root.getAttribute('data-phone') || '5491131547166';
    var KEY = 'ddm-cart';
    var listEl = document.getElementById('cart-list');
    var emptyEl = document.getElementById('cart-empty');
    var totalEl = document.getElementById('cart-total');
    var waEl = document.getElementById('cart-wa');
    var qtyEl = document.getElementById('cart-qty');
    var giftEl = document.getElementById('cart-gift');
    var noteEl = document.getElementById('cart-note');

    function money(n) {
      return new Intl.NumberFormat('es-AR', {
        style: 'currency',
        currency: 'ARS',
        maximumFractionDigits: 0,
      }).format(Math.round(n));
    }

    function load() {
      try {
        return JSON.parse(localStorage.getItem(KEY) || '[]');
      } catch (e) {
        return [];
      }
    }
    function save(items) {
      localStorage.setItem(KEY, JSON.stringify(items));
    }

    function selectedSize() {
      var el = root.querySelector('input[name="jar-size"]:checked');
      return {
        id: el.value,
        label: el.getAttribute('data-label'),
        factor: parseFloat(el.getAttribute('data-factor')),
      };
    }
    function selectedFlavor() {
      var el = root.querySelector('input[name="jar-flavor"]:checked');
      if (!el) return null;
      return { name: el.value, price: parseFloat(el.getAttribute('data-price')) };
    }

    function markChoices() {
      root.querySelectorAll('.cart-choice, .cart-jar').forEach(function (lab) {
        var inp = lab.querySelector('input');
        lab.classList.toggle('is-on', !!(inp && inp.checked && !inp.disabled));
      });
    }

    function qty() {
      var n = parseInt(qtyEl.value, 10);
      if (isNaN(n) || n < 1) n = 1;
      if (n > 4) n = 4;
      qtyEl.value = String(n);
      return n;
    }

    function message(items) {
      var lines = ['Hola! Quiero pedir Dulces de Mamá:', ''];
      var total = 0;
      items.forEach(function (it) {
        lines.push('• ' + it.qty + ' × ' + it.flavor + ' — frasco ' + it.sizeLabel);
        total += it.qty * it.unit;
      });
      lines.push('');
      lines.push('Estimado: ' + money(total) + ' (orientativo)');
      lines.push('Es para regalo: ' + (giftEl.checked ? 'sí' : 'no'));
      var note = (noteEl.value || '').trim();
      if (note) lines.push('Nota: ' + note);
      lines.push('Zona: CABA / GBA');
      return lines.join('\n');
    }

    function render() {
      var items = load();
      listEl.innerHTML = '';
      var total = 0;
      items.forEach(function (it, idx) {
        total += it.qty * it.unit;
        var li = document.createElement('li');
        li.className = 'cart-line';
        li.innerHTML =
          '<div><strong>' +
          it.flavor +
          '</strong><div class="cart-line-meta">' +
          it.qty +
          ' × frasco ' +
          it.sizeLabel +
          ' · ' +
          money(it.unit) +
          '</div></div><button type="button" class="cart-remove" data-i="' +
          idx +
          '">Quitar</button>';
        listEl.appendChild(li);
      });
      emptyEl.hidden = items.length > 0;
      totalEl.hidden = items.length === 0;
      totalEl.textContent = items.length ? 'Estimado: ' + money(total) : '';
      var text =
        items.length > 0
          ? message(items)
          : 'Hola! Quiero pedir Dulces de Mamá';
      var href =
        'https://wa.me/' + phone + '?text=' + encodeURIComponent(text);
      waEl.href = href;
      document.querySelectorAll('[data-cart-wa]').forEach(function (a) {
        a.setAttribute('href', href);
      });
      window.dispatchEvent(new CustomEvent('ddm-cart', { detail: { items: items, href: href } }));
    }

    function addItem(flavor, price, size, n) {
      var items = load();
      var unit = price * size.factor;
      var found = items.find(function (it) {
        return it.flavor === flavor && it.sizeId === size.id;
      });
      if (found) {
        found.qty = Math.min(4, found.qty + n);
      } else {
        items.push({
          flavor: flavor,
          sizeId: size.id,
          sizeLabel: size.label,
          unit: unit,
          qty: n,
        });
      }
      save(items);
      render();
    }

    document.getElementById('cart-add').addEventListener('click', function () {
      var f = selectedFlavor();
      if (!f) return;
      addItem(f.name, f.price, selectedSize(), qty());
    });

    listEl.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-i]');
      if (!btn) return;
      var items = load();
      items.splice(parseInt(btn.getAttribute('data-i'), 10), 1);
      save(items);
      render();
    });

    root.querySelectorAll('[data-qty]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var n = qty();
        qtyEl.value = String(btn.getAttribute('data-qty') === '+' ? Math.min(4, n + 1) : Math.max(1, n - 1));
      });
    });
    qtyEl.addEventListener('change', qty);

    root.querySelectorAll('input[name="jar-size"], input[name="jar-flavor"]').forEach(function (inp) {
      inp.addEventListener('change', markChoices);
    });
    giftEl.addEventListener('change', render);
    noteEl.addEventListener('input', render);

    window.addEventListener('ddm-add', function (e) {
      var d = e.detail || {};
      if (!d.flavor) return;
      addItem(d.flavor, d.price, selectedSize(), d.qty || 1);
      document.getElementById('pedido').scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    markChoices();
    render();
  })();
</script>
